FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY remote_dorado/ ./remote_dorado/
COPY scripts/control_plane_admin.py ./scripts/control_plane_admin.py
RUN pip install --no-cache-dir . && \
    useradd --system --uid 10001 --no-create-home dorado-control && \
    mkdir -p /app/data && chown 10001:10001 /app/data && chmod 0700 /app/data
USER dorado-control
EXPOSE 8790
CMD ["remote-dorado-control-plane"]
