# Private relay server (set these ONLY on the server; never inside binary releases).
DORADO_PUBLIC_URL=https://mcp.example.com
DORADO_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD_MIN_16_CHARS
DORADO_DB=./data/dorado.sqlite3
DORADO_BIND_HOST=127.0.0.1
DORADO_PORT=8765

# Legacy shared-agent compatibility only. New agents pair via the browser,
# get their own distinct revocable credential, and do not need this variable.
# DORADO_AGENT_TOKEN=REPLACE_WITH_RANDOM_AGENT_TOKEN_MIN_32_CHARS
